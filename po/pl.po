#: Settings.ui:2087
msgid "Binary"
msgstr "Binarne"

#: Settings.ui:2088
msgid "Dot"
msgstr "Kropka"

#: Settings.ui:2121
msgid "Set the background color for the dash."
msgstr "Ustala kolor tła kokpitu."

#: Settings.ui:2139
msgid "Customize the dash color"
msgstr "Dostosowanie koloru kokpitu"

#: Settings.ui:2195
msgid "Tune the dash background opacity."
msgstr "Dostosowuje nieprzejrzystość tła kokpitu."

#: Settings.ui:2245
msgid "Fixed"
msgstr "Ustalona"

#: Settings.ui:2246
msgid "Dynamic"
msgstr "Dynamiczna"

#: Settings.ui:2270
msgid "Opacity"
msgstr "Nieprzejrzystość"

#: Settings.ui:2307
msgid "Appearance"
msgstr "Wygląd"

#: Settings.ui:2346
msgid "version: "
msgstr "wersja: "

#: Settings.ui:2361
msgid "Moves the dash out of the overview transforming it in a dock"
msgstr "Przenosi kokpit poza widok podglądu, zmieniając go w dok"

#: Settings.ui:2375
msgid "Created by"
msgstr "Autor"

#: Settings.ui:2388
msgid "Webpage"
msgstr "Strona internetowa"

