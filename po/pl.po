#: Settings.ui:2412
msgid "About"
msgstr "O aplikacji"

#: Settings.ui:2470
msgid "Customize minimum and maximum opacity values"
msgstr "Dostosowanie minimalnej i maksymalnej wartości nieprzejrzystości"

#: Settings.ui:2492
msgid "Minimum opacity"
msgstr "Minimalna nieprzejrzystość"

#: Settings.ui:2522
msgid "Maximum opacity"
msgstr "Maksymalna nieprzejrzystość"

#: Settings.ui:2603
msgid "Number overlay"
msgstr "Nakładka z numerami"

#: Settings.ui:2614
msgid ""
"Temporarily show the application numbers over the icons, corresponding to "
"the shortcut."
msgstr "Wyświetla chwilowo na ikonach numery aplikacji powiązane ze skrótami."

#: Settings.ui:2660
msgid "Show the dock if it is hidden"
msgstr "Wyświetlanie ukrytego doku"

#: Settings.ui:2671
msgid ""
"If using autohide, the dock will appear for a short time when triggering the "
"shortcut."
msgstr ""
"Przy włączonym automatycznym ukrywaniu dok pojawia się na chwilę po "
"naciśnięciu skrótu klawiszowego."

#: Settings.ui:2714
msgid "Shortcut for the options above"
msgstr "Skrót klawiszowy powyższych opcji"

#: Settings.ui:2725
msgid "Syntax: <Shift>, <Ctrl>, <Alt>, <Super>"
msgstr "Składnia: <Shift>, <Ctrl>, <Alt>, <Super>"

#: Settings.ui:2772 Settings.ui:3070
msgid "Hide timeout (s)"
msgstr "Opóźnienie ukrywania (s)"

#: Settings.ui:2829
msgid "Show the dock by mouse hover on the screen edge."
msgstr "Wyświetla dok po przemieszczeniu wskaźnika myszy do krawędzi ekranu."

#: Settings.ui:2846
msgid "Autohide"
msgstr "Automatyczne ukrywanie"

#: Settings.ui:2867
msgid "Push to show: require pressure to show the dock"
msgstr "Wyświetlanie naciskiem: wymaga dociśnięcia do krawędzi"

#: Settings.ui:2878
msgid "Enable in fullscreen mode"
msgstr "Wyświetlanie na pełnym ekranie"

#: Settings.ui:2890
msgid "Show dock for urgent notifications"
msgstr "Wyświetlanie doku przy pilnych powiadomieniach"

#: Settings.ui:2919
msgid "Show the dock when it doesn't obstruct application windows."
msgstr "Wyświetla dok, jeśli nie zakrywa okien aplikacji."

#: Settings.ui:2936
msgid "Dodge windows"
msgstr "Ukrywanie przed oknami"

#: Settings.ui:2961
msgid "All windows"
msgstr "Wszystkie okna"

#: Settings.ui:2969
msgid "Only focused application's windows"
msgstr "Tylko okna aktywnej aplikacji"

#: Settings.ui:2976
msgid "Only maximized windows"
msgstr "Tylko zmaksymalizowane okna"

#: Settings.ui:2983
msgid "Always on top"
msgstr "Zawsze na wierzchu"

#: Settings.ui:3026
msgid "Animation duration (s)"
msgstr "Czas animacji (s)"

#: Settings.ui:3082
msgid "Show timeout (s)"
msgstr "Opóźnienie wyświetlania (s)"

#: Settings.ui:3094
msgid "Pressure threshold"
msgstr "Próg nacisku"
