msgid "Default"
msgstr "Domyślnie"

#: Settings.ui:2080
msgid "Dots"
msgstr "Kropki"

#: Settings.ui:2081
msgid "Squares"
msgstr "Kwadraty"

#: Settings.ui:2082
msgid "Dashes"
