#: Settings.ui:305
msgid "Enable Unity7 like glossy backlit items"
msgstr "Abilitare elementi lucidi retroilluminati come Unity7"

#: Settings.ui:318
msgid "Apply glossy effect."
msgstr "Applica effetto lucido."

#: Settings.ui:330
msgid "Use dominant color"
